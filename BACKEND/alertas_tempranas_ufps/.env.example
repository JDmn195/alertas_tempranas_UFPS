# ============================================================
#  COPIA ESTE ARCHIVO COMO .env Y RELLENA TUS VALORES
#  cp .env.example .env  (Linux/Mac)
#  copy .env.example .env  (Windows)
# ============================================================

# --- Base de datos (Neon PostgreSQL) ---
DATABASE_URL=url_de_la_bd
DB_NAME=neondb
DB_USER=tu_usuario_aqui
DB_PASSWORD=tu_password_aqui
DB_HOST=tu_host_aqui.neon.tech
DB_PORT=5432

# --- Django ---
# Obligatoria con DEBUG=False. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=genera-una-key-segura-aqui
# Por defecto False (producción). Ponlo en True solo en desarrollo local.
DEBUG=True
# Obligatoria con DEBUG=False (en Render basta RENDER_EXTERNAL_HOSTNAME)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Configuración de Correo ---
# Para desarrollo: django.core.mail.backends.console.EmailBackend
# Para producción: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-password-de-aplicacion
DEFAULT_FROM_EMAIL=Alertas Tempranas UFPS <tu-correo@gmail.com>

# --- Frontend ---  
FRONTEND_URL=http://localhost:5173

# --- Límites de subida ---
# Tamaño máximo permitido para archivos de importación (en MB). Por defecto: 10
MAX_IMPORT_FILE_SIZE_MB=10
# Porcentaje máximo de registros inválidos antes de cancelar una importación de estudiantes
IMPORT_MAX_PORCENTAJE_INVALIDOS=10

# --- CORS ---
# En desarrollo se permite todo (DEBUG=True lo controla automáticamente).
# En producción, lista los orígenes permitidos separados por coma:
# CORS_ALLOWED_ORIGINS=https://tu-frontend.com,https://otro-origen.com
CORS_ALLOWED_ORIGINS=

# --- Supabase Storage ---
# Reemplaza con los datos reales (Supabase > Project Settings > API). Con los valores
# de ejemplo la subida de evidencias falla. Verifica con: python manage.py verificar_almacenamiento
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key-aqui
SUPABASE_BUCKET_NAME=evidencias

# --- Brevo (notificaciones por correo) ---
BREVO_API_KEY=your_api_key_here
BREVO_SENDER_EMAIL=your_sender_email_here

# HU-29: Re-evaluación periódica del riesgo
# Token que envía el programador (GitHub Actions) en el header X-Cron-Token.
# Vacío = endpoint programado deshabilitado.
REEVALUACION_CRON_TOKEN=
REEVALUACION_MAX_INTENTOS=3
REEVALUACION_ESPERA_SEGUNDOS=60

# HU-30: Recordatorios de alertas e intervenciones sin seguimiento
# Valores iniciales; luego se ajustan en /api/alertas/recordatorios/configuracion/
RECORDATORIOS_DIAS_INACTIVIDAD_ALERTA=7
RECORDATORIOS_DIAS_INACTIVIDAD_INTERVENCION=15
RECORDATORIOS_DIAS_ENTRE_RECORDATORIOS=7
RECORDATORIOS_MAX_INTENTOS=3
RECORDATORIOS_ROLES_DESTINATARIOS=DIRECTOR
RECORDATORIOS_BLOQUEO_HORAS=2
# Vacío = usa REEVALUACION_CRON_TOKEN
RECORDATORIOS_CRON_TOKEN=
